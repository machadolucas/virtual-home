{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "id": "/",
  "name": "virtual-home",
  "short_name": "Home",
  "description": "Home management for one household: schedules, supplies and the house itself.",
  "start_url": "/today",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#faf9f5",
  "theme_color": "#faf9f5",
  "lang": "en",
  "dir": "ltr",
  "categories": [
    "utilities",
    "productivity"
  ],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/icons/icon-192-v2.png",
      "type": "image/png",
      "sizes": "192x192",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512-v2.png",
      "type": "image/png",
      "sizes": "512x512",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-512-v2.png",
      "type": "image/png",
      "sizes": "512x512",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Today",
      "short_name": "Today",
      "url": "/today",
      "description": "What needs doing now"
    },
    {
      "name": "House",
      "short_name": "House",
      "url": "/house",
      "description": "The 3D house workspace"
    },
    {
      "name": "Supplies",
      "short_name": "Supplies",
      "url": "/supplies",
      "description": "Stock and shopping list"
    }
  ]
}
