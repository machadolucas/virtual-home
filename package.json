{
  "name": "virtual-home",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3010",
    "build": "next build && pnpm run worker:build",
    "start": "next start --hostname ${HOST:-127.0.0.1} --port ${PORT:-3010}",
    "worker:dev": "VH_ROLE=worker tsx watch src/worker/index.ts",
    "worker:build": "esbuild src/worker/index.ts --bundle --platform=node --target=node24 --format=esm --packages=external --sourcemap --outfile=dist/worker/index.js",
    "worker:start": "VH_ROLE=worker node dist/worker/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "VH_ROLE=cli tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "vh-admin": "VH_ROLE=cli tsx scripts/vh-admin.ts",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "better-auth": "1.7.3",
    "better-sqlite3": "^12.11.1",
    "camera-controls": "^3.1.2",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.41.0",
    "next": "16.3.4",
    "pino": "^10.3.1",
    "pino-roll": "^4.0.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "three": "^0.185.1",
    "uuid": "^14.0.2",
    "ws": "^8.21.3",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.4",
    "@types/uuid": "^11.0.0",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "pino-pretty": "^13.1.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@11.25.0"
}
