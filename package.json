{
  "name": "virtual-home",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3010",
    "build": "next build && pnpm run worker:build",
    "start": "next start --hostname ${HOST:-127.0.0.1} --port ${PORT:-3010}",
    "worker:dev": "VH_ROLE=worker tsx --env-file-if-exists=.env.local watch src/worker/index.ts",
    "worker:build": "esbuild src/worker/index.ts --bundle --platform=node --target=node24 --format=esm --packages=external --alias:server-only=./scripts/lib/serverOnlyEmpty.ts --sourcemap --outfile=dist/worker/index.mjs && node --input-type=module -e \"await import('./dist/worker/index.mjs')\"",
    "worker:start": "VH_ROLE=worker node dist/worker/index.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "VH_ROLE=cli tsx --env-file-if-exists=.env.local src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "vh-admin": "VH_ROLE=cli tsx --env-file-if-exists=.env.local scripts/vh-admin.ts",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test",
    "fixture:model": "tsx scripts/make-fixture-model.ts"
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.22",
    "@date-fns/tz": "1.5.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "better-auth": "1.7.22",
    "better-sqlite3": "13.1.1",
    "camera-controls": "3.1.2",
    "date-fns": "4.4.0",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.72.0",
    "next": "16.4.6",
    "pdfjs-dist": "6.5.438",
    "pino": "10.4.0",
    "pino-roll": "4.0.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "three": "0.187.0",
    "uuid": "14.0.3",
    "ws": "8.23.0",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@types/ws": "8.18.2",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "pino-pretty": "13.2.0",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "packageManager": "pnpm@12.18.0"
}
