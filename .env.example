# Copy to .env.local for development (never commit). Production uses $VH_DATA_DIR/secrets/vh.env.
NODE_ENV=development
VH_DATA_DIR=/Users/you/virtual-home-data
VH_BASE_URL=http://localhost:3010
# VH_TRUSTED_ORIGINS=http://localhost:3010,http://192.168.1.50:3010
VH_HOUSEHOLD_TZ=Europe/Helsinki
VH_DELIVERY_TIME=09:00
HOST=127.0.0.1
PORT=3010
LOG_LEVEL=debug
BETTER_AUTH_SECRET=change-me-generate-with-openssl-rand-base64-48
# Home Assistant (worker). Create the token in HA: Profile -> Security -> Long-lived access tokens.
HA_URL=http://192.168.1.181:8123
HA_TOKEN=
# Enable browser test hooks (window.__vh) in dev/test builds only.
NEXT_PUBLIC_VH_TEST_HOOK=1
